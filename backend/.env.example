PORT=3000
MONGODB_URI=
JWT_SECRET=
# Session length in minutes (ACC-06: 30). The old JWT_EXPIRES_IN variable is ignored.
JWT_EXPIRES_MINUTES=30
FRONTEND_URL=http://localhost:3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FXRATES_API_KEY=
UPLOAD_DIR=uploads
# ACC-18: an admin is created at startup from these two values if no user has that email.
# The password needs 8-64 characters with an upper-case letter, a lower-case letter and a number.
ADMIN_EMAIL=
ADMIN_PASSWORD=
